YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt-5-lite
YANDEX_GPT_FALLBACK_MODELS=yandexgpt-5.1,yandexgpt-5-pro

# Основной провайдер — Yandex AI Studio
RAG_LLM_PROVIDER=yandex
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=google/gemma-3-4b
LOCAL_LLM_API_KEY=lm-studio

# Базовые параметры. 
YANDEX_TEMPERATURE=0.1
YANDEX_MAX_OUTPUT_TOKENS=700

# Retrieval-конфигурация, выбранная на этапе сравнения методов.
RAG_USE_RERANKER=true
RAG_TOP_K=5
RAG_CANDIDATE_K=60
RAG_RERANKER_CANDIDATE_K=10
RAG_BM25_WEIGHT=0.5
RAG_RRF_K=60
RAG_DEVICE=cpu

# Адрес backend для Streamlit.
RAG_BACKEND_URL=http://127.0.0.1:8000
