# Frozen experiment protocol. The runner refuses incompatible values.
MODEL_ID=Qwen/Qwen2.5-3B-Instruct
MODEL_REVISION=aa8e72537993ba99e69dfaafa59ed015b17504d1
MODEL_PATH=/root/.cache/huggingface/hub/models--Qwen--Qwen2.5-3B-Instruct/snapshots/aa8e72537993ba99e69dfaafa59ed015b17504d1
SERVED_MODEL_NAME=qwen2.5-3b-instruct-benchmark
DTYPE=float16
TP_SIZE=1
CONTEXT_LENGTH=2048
MAX_SERVER_BATCH=16

# Stable images pinned to immutable Docker Hub manifest digests (2026-07-11).
SGLANG_IMAGE=lmsysorg/sglang:v0.5.15-cu129-runtime@sha256:c776530cdc5029994d0e3935c6c6d0a3746b9cafd0a19930b5bd3689585d4177
VLLM_IMAGE=vllm/vllm-openai:v0.25.0-cu129@sha256:f7415b0939b32377a1d16429a063977a4ec3224d537aa16af726597cc8e3cdac
LMDEPLOY_IMAGE=openmmlab/lmdeploy:v0.14.0-cu12.8@sha256:e5f59ec579ec0bc1472ee63705eb04152f30b8236ba97cfc116d21c1fdf3bc76
BENCHMARK_CLIENT_IMAGE=lmsysorg/sglang:v0.5.15-cu129-runtime@sha256:c776530cdc5029994d0e3935c6c6d0a3746b9cafd0a19930b5bd3689585d4177

# Online serving workload. Batch size means maximum concurrent requests.
BATCH_SIZES="1 2 4 8 16"
NUM_PROMPTS=80
WARMUP_REQUESTS=16
REPEATS=5
INPUT_LENGTH=512
OUTPUT_LENGTH=128
# RAG-like workload: one shared 128-token system prefix plus a unique
# 384-token context/question section for each request.
WORKLOAD=generated-shared-prefix
GSP_NUM_GROUPS=1
GSP_SYSTEM_PROMPT_LENGTH=128
GSP_QUESTION_LENGTH=384
GSP_RANGE_RATIO=1.0
DATASET_SEED_BASE=42000
ORDER_SEED=17017
GENERATION_SEED=42
TEMPERATURE=0.0
TOP_P=1.0

# Runtime and output settings.
ENGINE_ORDER="sglang vllm lmdeploy"
GPU_DEVICE_ID=0
# These settings have engine-specific semantics and are recorded separately.
SGLANG_MEM_FRACTION_STATIC=0.85
VLLM_GPU_MEMORY_UTILIZATION=0.85
LMDEPLOY_CACHE_MAX_ENTRY_COUNT=0.80
SERVER_PORT=18000
SERVER_READY_TIMEOUT_SECONDS=1200
ENGINE_COOLDOWN_SECONDS=10
TELEMETRY_INTERVAL_MS=200
HF_CACHE_VOLUME=rag-inference-hf-cache
HF_HUB_OFFLINE=1
PULL_IMAGES=1
PREFETCH_MODEL=1
EXPERIMENT_DIR=data/experiments/inference_engines
COMPOSE_PROJECT_NAME=rag-inference-engines

# Fail-fast capacity checks. The three images and FP16 model need substantial disk.
CUDA_PROBE_IMAGE=nvidia/cuda:12.9.1-base-ubuntu24.04
MIN_GPU_MEMORY_MIB=12000
RECOMMENDED_GPU_MEMORY_MIB=12000
MIN_FREE_DISK_GIB=70

# Qwen/Qwen2.5-3B-Instruct is public. If the Hub starts requiring authentication,
# export HF_TOKEN in the shell before running; never save it in this file.
